{
	"name": "@yacosta738/ascii-progress-bar-documents",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"update-deps": "pnpm update -i -r --latest",
		"preinstall": "npx only-allow pnpm",
		"build": "pnpm -r build && astro build",
		"build:packages": "pnpm --filter './packages/**' build",
		"test": "pnpm -r test",
		"dev": "pnpm run build:packages && astro dev",
		"start": "pnpm run dev",
		"preview": "astro preview",
		"astro": "astro",
		"clean": "pnpm -r clean",
		"check": "pnpm biome check --write . && astro check"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/starlight": "^0.43.0",
		"@yacosta738/ascii-progress-bar": "workspace:*",
		"astro": "^7.4.4",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"typescript": "^6.0.3"
	},
	"resolutions": {
		"lodash": ">=4.18.0",
		"lodash-es": ">=4.18.0",
		"yaml": ">=2.8.3",
		"picomatch": ">=4.0.4"
	},
	"packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
