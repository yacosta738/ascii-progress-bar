{
	"name": "@yacosta738/ascii-progress-bar-documents",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"update-deps": "pnpm update -i -r --latest",
		"preinstall": "npx only-allow pnpm && pnpm run build:packages",
		"build": "pnpm -r build && astro build",
		"build:packages": "pnpm --filter './packages/**' build",
		"test": "pnpm -r test",
		"dev": "pnpm run build:packages && astro dev",
		"start": "pnpm run dev",
		"preview": "astro preview",
		"astro": "astro",
		"clean": "pnpm -r clean",
		"check": "pnpm biome check --write . && astro check"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/starlight": "^0.39.2",
		"@yacosta738/ascii-progress-bar": "workspace:*",
		"astro": "^6.3.7",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"typescript": "^6.0.3"
	},
	"resolutions": {
		"lodash": ">=4.18.0",
		"lodash-es": ">=4.18.0",
		"yaml": ">=2.8.3",
		"picomatch": ">=4.0.4"
	},
	"packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
