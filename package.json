{
	"name": "@yacosta738/ascii-progress-bar-documents",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"update-deps": "pnpm update -i -r --latest",
		"preinstall": "npx only-allow pnpm && pnpm run build:packages",
		"build": "pnpm -r build && astro build",
		"build:packages": "pnpm --filter './packages/**' build",
		"test": "pnpm -r test",
		"dev": "pnpm run build:packages && astro dev",
		"start": "pnpm run dev",
		"preview": "astro preview",
		"astro": "astro",
		"clean": "pnpm -r clean",
		"check": "pnpm biome check --write . && astro check"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/starlight": "^0.42.8",
		"@yacosta738/ascii-progress-bar": "workspace:*",
		"astro": "^7.4.4",
		"sharp": "^0.35.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"typescript": "^6.0.3"
	},
	"resolutions": {
		"lodash": ">=4.18.0",
		"lodash-es": ">=4.18.0",
		"yaml": ">=2.8.3",
		"picomatch": ">=4.0.4"
	},
	"packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
