{
	"name": "@yacosta738/ascii-progress-bar-documents",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"update-deps": "pnpm update -i -r --latest",
		"preinstall": "npx only-allow pnpm && pnpm run build:packages",
		"build": "pnpm -r build && astro build",
		"build:packages": "pnpm --filter './packages/**' build",
		"test": "pnpm -r test",
		"dev": "pnpm run build:packages && astro dev",
		"start": "pnpm run dev",
		"preview": "astro preview",
		"astro": "astro",
		"clean": "pnpm -r clean",
		"check": "pnpm biome check --write . && astro check"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/starlight": "^0.42.8",
		"@yacosta738/ascii-progress-bar": "workspace:*",
		"astro": "^7.4.4",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"typescript": "^6.0.3"
	},
	"resolutions": {
		"lodash": ">=4.18.0",
		"lodash-es": ">=4.18.0",
		"yaml": ">=2.8.3",
		"picomatch": ">=4.0.4"
	},
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
